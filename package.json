{
  "name": "@postfinder/client",
  "version": "0.1.1",
  "description": "Find post offices, parcel lockers and post boxes near a point, and look up postcodes. Free and keyless.",
  "keywords": [
    "post office locator",
    "parcel locker api",
    "post box locations",
    "postcode api",
    "postcode lookup",
    "australia post locations",
    "store locator",
    "nearest location",
    "openstreetmap",
    "geonames",
    "typescript",
    "australia"
  ],
  "license": "MIT",
  "homepage": "https://postfinder.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/postfinder/postfinder-js.git"
  },
  "bugs": {
    "url": "https://github.com/postfinder/postfinder-js/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^5.0.1"
  }
}
